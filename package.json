{
  "name": "takumi-motion",
  "version": "1.1.0",
  "description": "Deterministic server-side animation engine: React or HTML \u2192 GIF/WebP/APNG/PNG-sequence/sprite-sheet/still at any surface, rendered by Rust (takumi). v1.0 Velocity: solver/tween/compile/evaluate memoization, binary-search chunk index, zero-copy GIF passes, min-SAD PNG filtering (\u221290%+ atlas bytes), worker-pool parallel capture via bannerModule, frame-seeded determinism shim, esbuild TS loader for JSX banners.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "takumi-motion": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js",
    "./audit": "./dist/with-audit.js",
    "./fonts": "./dist/fonts.js",
    "./recipes": "./dist/templates/index.js",
    "./package.json": "./package.json",
    "./kit": "./dist/react/kit.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "example": "tsx examples/react-banner.tsx",
    "example:banners": "tsx examples/readme-banner.ts",
    "cli": "tsx src/cli.ts",
    "fixtures": "node scripts/extract-fixtures.mjs",
    "smoke": "node smoke.mjs",
    "proof:v04": "tsx scripts/proof-v04.mts",
    "proof:v05": "tsx scripts/proof-v05.mts",
    "proof:v06": "tsx scripts/proof-v06.mts",
    "build:tsc": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "takumi",
    "motion",
    "animation",
    "engine",
    "deterministic",
    "server-side",
    "gif",
    "webp",
    "apng",
    "png-sequence",
    "spritesheet",
    "og-image",
    "banner",
    "react",
    "remotion-style",
    "spring",
    "charts",
    "data-visualization",
    "morph",
    "particles",
    "loop",
    "storyboard",
    "cli"
  ],
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@takumi-rs/helpers": ">=2.17.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@takumi-rs/core": "^2.17.1",
    "@takumi-rs/helpers": "^2.17.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "motion": "^14.6.0",
    "takumi-js": "^2.17.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/takumi-motion.git"
  },
  "homepage": "https://github.com/elcoosp/takumi-motion#readme",
  "bugs": {
    "url": "https://github.com/elcoosp/takumi-motion/issues"
  },
  "author": "elcoosp",
  "engines": {
    "node": ">=22"
  },
  "prepublishOnly": "npm run build && npm test",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
