{
  "name": "takumi-motion-docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official documentation site for takumi-motion — deterministic server-side animation engine — built with Astro Starlight.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "markdownlint-cli2 \"src/content/docs/**/*.{md,mdx}\"",
    "llms": "node scripts/build-llms.mjs",
    "prebuild": "node scripts/build-llms.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#c4b8331abb1dc2f157d62fba634eeb17f5e689cd",
    "markdownlint-cli2": "^0.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "@elcoosp/docs-toolkit": "github:elcoosp/docs-toolkit#dd2fa6d7981534c0e3b230f4eed59e38bd51e4e5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.16.1",
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
